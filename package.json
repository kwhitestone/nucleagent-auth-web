{
  "name": "nucleagent-auth-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=src/addons/auth-account/api/authFailurePolicy.ts --test-coverage-include=src/addons/auth-account/api/requestIdPolicy.ts --test-coverage-include=src/addons/access-control/composables/accessI18n.ts --test-coverage-include=src/addons/auth-account/composables/authAuthorityPolicy.ts --test-coverage-include=src/addons/auth-account/composables/permissionPolicy.ts --test-coverage-include=src/addons/access-control/composables/authorizationPolicy.ts --test-coverage-include=src/addons/auth-account/composables/shellMessagePolicy.ts --test-coverage-include=src/composables/useSessionRequests.ts --test-coverage-include=src/utils/token.ts --test-coverage-include=src/addons/auth-account/api/http.ts --test-coverage-include=src/addons/auth-account/api/auth.ts --test-coverage-include=src/addons/auth-account/store/user.ts --test-coverage-include=src/addons/auth-account/composables/useShellBridge.ts --test-coverage-include=src/addons/access-control/api/rbac.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "pinia": "^2.2.0",
    "axios": "^1.7.0",
    "vue-i18n": "~9.14.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "^5.5.0",
    "vite": "6.4.3",
    "vue-tsc": "^2.1.0"
  }
}
